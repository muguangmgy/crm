<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.platform.server.crm.customer.mapper.ContactMapper">

    <select id="selectByCustomerId" resultType="com.platform.server.crm.customer.po.CrmCustomerContact">
        SELECT *
        FROM crm_customer_contact
        WHERE customer_id = #{customerId}
        ORDER BY is_primary DESC, create_time DESC
    </select>

</mapper>