<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.platform.server.system.log.oper.mapper.SysOperLogMapper">

    <resultMap id="OperLogVOMap" type="com.platform.server.system.log.oper.vo.OperLogVO">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="user_code" property="userCode"/>
        <result column="user_name" property="userName"/>
        <result column="module" property="module"/>
        <result column="operation" property="operation"/>
        <result column="target_type" property="targetType"/>
        <result column="target_id" property="targetId"/>
        <result column="request_data" property="requestData"/>
        <result column="response_status" property="responseStatus"/>
        <result column="ip_address" property="ipAddress"/>
        <result column="oper_time" property="operTime"/>
        <result column="duration" property="duration"/>
    </resultMap>

    <!-- 多表关联查询：操作日志列表 -->
    <select id="selectLogPage" resultMap="OperLogVOMap">
        SELECT l.id, l.tenant_id, l.user_code, u.user_name, l.module, l.operation,
        l.target_type, l.target_id, l.request_data, l.response_status,
        l.ip_address, l.oper_time, l.duration
        FROM sys_oper_log l
        LEFT JOIN sys_user u ON l.user_code = u.user_code
        WHERE 1=1
        <if test="query.userCode != null and query.userCode != ''">AND l.user_code = #{query.userCode}</if>
        <if test="query.module != null and query.module != ''">AND l.module LIKE CONCAT('%', #{query.module}, '%')</if>
        <if test="query.operation != null and query.operation != ''">
            AND l.operation LIKE CONCAT('%', #{query.operation},'%')
        </if>
        <if test="query.responseStatus != null">AND l.response_status = #{query.responseStatus}</if>
        ORDER BY l.oper_time DESC
    </select>

</mapper>