<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.platform.server.system.dept.mapper.SysDeptMapper">

    <resultMap id="DeptVOMap" type="com.platform.server.system.dept.vo.DeptVO">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="parent_id" property="parentId"/>
        <result column="dept_name" property="deptName"/>
        <result column="dept_path" property="deptPath"/>
        <result column="leader_id" property="leaderId"/>
        <result column="leader_name" property="leaderName"/>
        <result column="sort" property="sort"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <!-- 多表关联查询：部门树（关联用户表获取负责人姓名） -->
    <select id="selectDeptTree" resultMap="DeptVOMap">
        SELECT d.id,
        d.tenant_id,
        d.parent_id,
        d.dept_name,
        d.dept_path,
        d.leader_id,
        u.user_name as leader_name,
        d.sort,
        d.status,
        d.create_time
        FROM sys_dept d
        LEFT JOIN sys_user u ON d.leader_id = u.id
        WHERE d.status = 1
        ORDER BY d.sort ASC, d.id ASC
    </select>

    <!-- 多表关联查询：部门详情（关联用户表获取负责人姓名） -->
    <select id="selectDeptById" resultMap="DeptVOMap">
        SELECT d.id,
        d.tenant_id,
        d.parent_id,
        d.dept_name,
        d.dept_path,
        d.leader_id,
        u.user_name as leader_name,
        d.sort,
        d.status,
        d.create_time
        FROM sys_dept d
        LEFT JOIN sys_user u ON d.leader_id = u.id
        WHERE d.id = #{id}
    </select>
</mapper>